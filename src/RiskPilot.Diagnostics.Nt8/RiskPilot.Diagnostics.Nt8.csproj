  <!--
    The window UI (NTWindow + WPF) is compiled ONLY for the real host build. The offline
    stub build has no WPF or NinjaTrader.Gui surface, and Phase 1 §6.2 scopes the Ui layer
    to the real host. All UI-adjacent logic that must be testable offline lives in Core/Run.
  -->
  <ItemGroup Condition="'$(UseStubs)' != 'true'">
    <Compile Include="Host\DiagnosticCenterWindow.cs" />
    <Compile Include="Host\DiagnosticCenterWindowManager.cs" />
    <Compile Include="Host\MenuIntegration.cs" />
