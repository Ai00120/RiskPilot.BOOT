<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RiskPilot NT8 Diagnostic Center — SAMPLE report generator.

    This is an offline tool (not part of the AddOn) that builds a clearly-labelled SAMPLE
    evidence package using the REAL production EvidencePackageBuilder. Every record in the
    sample is synthetic and the manifest/summary are marked SAMPLE, so the artifact can never
    be mistaken for a live runtime result. It exists so a reviewer can see the exact package
    shape the AddOn produces without a NinjaTrader host.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RiskPilot.Diagnostics.SampleReport</AssemblyName>
    <RootNamespace>RiskPilot.Diagnostics.SampleReport</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RiskPilot.Diagnostics.Nt8\RiskPilot.Diagnostics.Nt8.csproj" />
  </ItemGroup>

</Project>
