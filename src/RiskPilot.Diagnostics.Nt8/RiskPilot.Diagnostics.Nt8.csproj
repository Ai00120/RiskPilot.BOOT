<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RiskPilot NT8 Diagnostic Center — standalone, read-only NinjaTrader 8 AddOn.
    Target host: NinjaTrader 8.1.9.0 (64-bit), minimum supported 8.1.8.4,
    .NET Framework 4.8, C# 8.0. Real-host compatibility is NOT verified offline
    (the NinjaTrader assemblies are not available); see Core/Identity/NinjaTraderCompatibility.cs.

    TWO BUILD MODES (identical to the RiskPilot.BOT convention):

    1) Inside NinjaTrader (canonical / real host):
       Compile the .cs files placed in Documents\NinjaTrader 8\bin\Custom\AddOns\
       with the NinjaScript Editor. The real NT8 assemblies are referenced there.
       A real build requires -p:UseStubs=false on Windows with NT8 installed.

    2) Outside NinjaTrader (offline CI / syntax check):
       dotnet build -p:UseStubs=true   -> net8.0 + Stubs/NinjaTraderStubs.cs + USE_STUBS
       dotnet build -p:UseStubs=false  -> net48, expects real NT8 assemblies

    A successful offline stub build is NOT proof of real host compatibility.
    This project has NO dependency on RiskPilot.BOT or its binaries.
  -->

  <PropertyGroup>
    <UseStubs Condition="'$(UseStubs)' == ''">true</UseStubs>
    <TargetFramework Condition="'$(UseStubs)' == 'true'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(UseStubs)' != 'true'">net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      Standalone builds (UseStubs=true AND UseStubs=false) keep their assembly metadata in
      Properties/AssemblyInfo.cs; SDK-generated assembly info is disabled so this project has
      exactly one copy. NinjaTrader's NinjaScript Editor does NOT read this .csproj: it compiles
      every .cs file under bin\Custom into its own NinjaTrader.Custom.dll, which already carries
      bin\Custom\AssemblyInfo.cs. Staging Properties/AssemblyInfo.cs (or any generated
      obj/**/*.AssemblyInfo.cs) into that tree causes CS0579 duplicate attributes. NEVER stage it;
      use tools/nt8-source-package/package_addon_sources.py. See docs/INSTALL.md.
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>RiskPilot.Diagnostics.Nt8</AssemblyName>
    <RootNamespace>RiskPilot.Diagnostics.Nt8</RootNamespace>
    <Description>RiskPilot NT8 Diagnostic Center — read-only diagnostics and host acceptance.</Description>
    <Version>1.0.0-phase2</Version>
    <Authors>RiskPilot</Authors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseStubs)' == 'true'">
    <DefineConstants>$(DefineConstants);USE_STUBS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
